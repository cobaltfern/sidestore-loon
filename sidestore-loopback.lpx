#!name=SideStore Loopback
#!desc=把发往 10.7.0.1 的连接反射回本机协议栈，替代 LocalDevVPN/StosVPN 供 SideStore 续签使用。需要 Loon Build 1007+。
#!author=fox
#!loon_version=3.5.3(1007)
#!system=iOS
#!type=normal

[General]
# 只把 SideStore 需要的单个地址塞进 TUN，不接管其它流量
include-tun = 10.7.0.1/32
# 避免有工具去挑 IPv6 虚拟接口
ipv6-vif = off

[IP Rewrite]
# 目的 10.7.0.1 的包交换源/目的后回注本机，命中设备自己的 remotepairingd:49152
10.7.0.1 = reflect
